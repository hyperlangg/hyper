# ASCII whitespace must behave the same in interpreted and compiled paths.
let ws = chr(32) + chr(9) + chr(10) + chr(13) + chr(11) + chr(12)
let text = ws + "alpha" + ws + "beta" + ws

print("<" + text.strip() + ">")
print("<" + text.lstrip() + ">")
print("<" + text.rstrip() + ">")
print(ws.isspace())
print(text.split())
